#~ msgstr "显示程序信息"

#~ msgid "Unknown"
#~ msgstr "未知"

#~ msgid "Show more details (_D)"
#~ msgstr "显示/隐藏详细信息(_D)"

#~ msgid "Show more details"
#~ msgstr "显示更多详细信息"

