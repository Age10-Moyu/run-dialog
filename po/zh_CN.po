#: src/main.rs:512 src/main.rs:537 src/main.rs:890 src/settings.rs:181
msgid "Run"
msgstr "运行"

#: src/main.rs:553
msgid ""
"Type the name of a program, folder, document, or Internet resource, and {1} "
"will open it for you."
msgstr "{1} 将根据你所输入的名称，为你打开相应的程序、文档或 Internet 资源。"

#: src/main.rs:569
msgid "Open (_O):"
msgstr "打开 (_O):"

#: src/main.rs:589 src/main.rs:592
msgid "Creating this task with administrative privileges."
msgstr "使用管理权限创建此任务。"

#: src/main.rs:599
msgid "Run this program as an administrator"
msgstr "以系统管理员权限创建此任务。"

#: src/main.rs:630 src/main.rs:926 src/main.rs:1447
msgid "OK"
msgstr "确定"

#: src/main.rs:635
msgid "Cancel"
msgstr "取消"

#: src/main.rs:638
msgid "_Browse..."
msgstr "浏览(_B)..."

#: src/main.rs:857
msgid "File"
msgstr "文件"

#: src/main.rs:999
msgid "User Account Control"
msgstr "用户账户控制"

#: src/main.rs:1015
msgid "Do you want to allow this app to make changes to your device?"
msgstr "你要允许此应用对你的设备进行更改吗？"

#: src/main.rs:1044 src/main.rs:1050
msgid "Unknown publisher"
msgstr "未知发布者"

#: src/main.rs:1045
msgid "Verified publisher: {1}"
msgstr "已验证的发布者: {1}"

#: src/main.rs:1051
msgid "Unverified publisher: {1}"
msgstr "未验证的发布者: {1}"

#: src/main.rs:1065 src/main.rs:1083
msgid "Show details (_D)"
msgstr "显示详细信息(_D)"

#: src/main.rs:1081
msgid "Hide details (_D)"
msgstr "隐藏详细信息(_D)"

#: src/main.rs:1095
msgid "Program location:"
msgstr "程序位置:"

#: src/main.rs:1111
msgid "This program is not digitally signed."
msgstr "此程序未签名。"

#: src/main.rs:1122
msgid "To continue, type an administrator user name and password."
msgstr "若要继续，请输入管理员用户名和密码。"

#: src/main.rs:1133
msgid "User name"
msgstr "用户名"

#: src/main.rs:1139
msgid "Password"
msgstr "密码"

#: src/main.rs:1158
msgid "Yes"
msgstr "是"

#: src/main.rs:1162
msgid "No"
msgstr "否"

#: src/main.rs:1243
msgid "Authentication failed: {1}"
msgstr "认证失败：{1}"

#: src/main.rs:1256
msgid "Authentication failed."
msgstr "认证失败。"

#: src/main.rs:1364
msgid "Publisher information"
msgstr "发布者信息"

#: src/main.rs:1381
msgid ""
"This platform does not provide code signing for desktop applications. The "
"information below is descriptive only and does not verify the publisher."
msgstr ""
"本平台不提供桌面应用的代码签名。以下信息仅供参考，不能用于验证发布者身份。"

#: src/main.rs:1389
msgid "Program"
msgstr "程序"

#: src/main.rs:1402
msgid "Path"
msgstr "路径"

#: src/main.rs:1404
msgid "Resolved path"
msgstr "实际路径"

#: src/main.rs:1412
msgid "Read from the binary's own metadata"
msgstr "读取自二进制文件自身的元数据"

#: src/main.rs:1413
msgid "Looked up via the package manager"
msgstr "通过包管理器反查得到"

#: src/main.rs:1414
msgid "Could not be determined"
msgstr "无法确定"

#: src/main.rs:1417
msgid "Publisher"
msgstr "发布者"

#: src/main.rs:1424
msgid "File type"
msgstr "文件类型"

#: src/main.rs:1426
msgid "Size"
msgstr "大小"

#: src/main.rs:1431
msgid "Build ID"
msgstr "构建 ID"

#: src/main.rs:1434
msgid "Not a signature"
msgstr "非签名"

#: src/main.rs:1437
msgid "Desktop entry"
msgstr "桌面条目"

#: src/main.rs:1654
msgid ""
"{1} cannot find '{2}'. Make sure you typed the name correctly, and then try "
"it again."
msgstr "{1} 找不到文件 '{2}'。请确定文件名是否正确后，再试一次。"

#: src/settings.rs:9
msgid "Run Settings"
msgstr "运行 设置"

#: src/settings.rs:30
msgid "Experimental"
msgstr "实验"

#: src/settings.rs:39
msgid "About"
msgstr "关于"

#: src/settings.rs:58
msgid "Windows compatibility layer"
msgstr "Windows 兼容层"

#: src/settings.rs:60
msgid ""
"Emulates the path and command translation of the Windows Run box. Off by "
"default, experimental only."
msgstr "模拟 Windows 运行框的路径与命令翻译。默认关闭，仅供实验。"

#: src/settings.rs:65
msgid "Enable Windows path translation"
msgstr "启用 Windows 路径翻译"

#: src/settings.rs:67
msgid ""
"Map C:\\ paths to their Linux counterparts and translate common .exe names"
msgstr "把 C:\\ 路径映射到 Linux 对应位置，并翻译常见 .exe"

#: src/settings.rs:78 src/settings.rs:104 src/settings.rs:138
msgid "Failed to save settings: {1}"
msgstr "保存配置失败：{1}"

#: src/settings.rs:88
msgid "Behavior"
msgstr "行为"

#: src/settings.rs:91
msgid "Choose when several apps match"
msgstr "多个应用匹配时弹出选择"

#: src/settings.rs:93
msgid "Show a list to pick from instead of launching the first match"
msgstr "列出所有匹配项让用户选择，而不是直接启动第一个"

#: src/settings.rs:117
msgid "Restore default settings"
msgstr "恢复默认设置"

#: src/settings.rs:119
msgid ""
"Turn off the Windows compatibility layer, use the first match, and clear "
"command history"
msgstr "关闭 Windows 兼容层、直接使用第一个匹配项，并清空命令历史"

#: src/settings.rs:123
msgid "Restore Defaults"
msgstr "恢复默认"

#: src/settings.rs:184
msgid "Version"
msgstr "版本"

#: src/settings.rs:190
msgid "Description"
msgstr "说明"

#: src/settings.rs:191
msgid "A GNOME-style run dialog"
msgstr "GNOME 风格的运行对话框"

#: src/settings.rs:196
msgid "Application ID"
msgstr "应用 ID"

#~ msgid "Several apps match \"{1}\". Pick one:"
#~ msgstr "有多个应用匹配“{1}”。请选择要运行的程序："

